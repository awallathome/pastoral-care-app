# The schema now targets Postgres (for the Vercel + Neon deployment), so
# both values need real Postgres connection strings — a plain "file:./dev.db"
# SQLite path no longer works here. Easiest for local dev: create a free
# Neon "dev" branch/database (separate from your production one) and use
# its connection strings for local work too.
#
# Both values come from your Neon project's "Connect" dialog. DATABASE_URL
# is the pooled connection string (hostname contains "-pooler") that the
# running app uses; DATABASE_URL_UNPOOLED is the direct one Prisma's CLI
# (migrate dev/deploy, etc.) needs — pooled connections can't run
# migrations reliably.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/pastoral_care?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/pastoral_care?sslmode=require"

# Generate a long random string for real use, e.g.: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# How long a login session stays valid before re-authenticating.
JWT_EXPIRES_IN="12h"

PORT=4000

# Protects POST/GET /cron/send-reminders (the overdue/today visit push
# notification job) from being triggered by strangers. Generate one the same
# way as JWT_SECRET. Vercel Cron automatically sends this as
# "Authorization: Bearer <value>" when it's set on the project — see
# vercel.json and README > Push notifications.
CRON_SECRET=""
