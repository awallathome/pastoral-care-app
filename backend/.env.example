# SQLite file for local prototyping. For production, point this at Postgres
# (e.g. postgresql://user:pass@host:5432/pastoral_care) and change the
# `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Generate a long random string for real use, e.g.: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# How long a login session stays valid before re-authenticating.
JWT_EXPIRES_IN="12h"

PORT=4000
