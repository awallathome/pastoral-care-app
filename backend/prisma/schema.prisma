// Pastoral Care App — data model
// SQLite for local prototyping. Swap `provider` to "postgresql" and set
// DATABASE_URL to a real Postgres connection string for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Access control -------------------------------------------------------

enum Role {
  ADMIN // manages users & full data access
  MINISTER // full access to their own parishioners, including notes
  SUPPORT_STAFF // scheduling/contact-info access only — CANNOT read/write notes
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  assignedPeople Person[]  @relation("AssignedMinister")
  visitsLogged   Visit[]   @relation("VisitLoggedBy")
  auditEntries   AuditLog[]
}

// --- Parishioner record ----------------------------------------------------

model Person {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  address   String?
  phone     String?
  email     String?
  notesFlag String? // short non-sensitive flag e.g. "Homebound" — shown to all roles
  photoUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedMinisterId String?
  assignedMinister   User?   @relation("AssignedMinister", fields: [assignedMinisterId], references: [id])

  familyMembers     FamilyMember[]
  emergencyContacts EmergencyContact[]
  visits            Visit[]
}

// Lightweight family reference — deliberately thin. We store just enough to
// answer "who are this person's people" without creating a full sensitive
// record for the family member themselves (see README > Handling Sensitive Data).
model FamilyMember {
  id           String  @id @default(cuid())
  personId     String
  person       Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  name         String
  relationship String // "Spouse", "Daughter", "Son", "Sibling", etc.
  phone        String?
}

model EmergencyContact {
  id           String  @id @default(cuid())
  personId     String
  person       Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  name         String
  relationship String?
  phone        String
  email        String?

  alternateForVisits Visit[] @relation("VisitAlternateContact")
}

// --- Visits / schedule -----------------------------------------------------

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELED
  RESCHEDULED
}

enum ContactMethod {
  IN_PERSON
  PHONE
  EMAIL
  TEXT
  OTHER
}

model Visit {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  scheduledFor DateTime
  status       VisitStatus @default(SCHEDULED)
  contactMethod ContactMethod?  // set once the visit/contact actually happens
  notes         String?         // SENSITIVE — access gated by role, see rbac.ts

  alternateContactId String?
  alternateContact   EmergencyContact? @relation("VisitAlternateContact", fields: [alternateContactId], references: [id])

  loggedById String?
  loggedBy   User?   @relation("VisitLoggedBy", fields: [loggedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Accountability ---------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // e.g. "VIEW_NOTES", "EDIT_NOTES", "VIEW_PERSON"
  personId  String?
  visitId   String?
  createdAt DateTime @default(now())
}
