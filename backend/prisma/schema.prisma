// Pastoral Care App — data model
// Postgres (hosted on Neon for the Vercel deployment). `url` is the pooled
// connection string (hostname contains "-pooler") that the running app
// uses; `directUrl` is the unpooled one Prisma CLI commands like
// `migrate deploy` need. Both come from your Neon project's dashboard.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// --- Access control -------------------------------------------------------

// `role` is a plain string rather than a native Postgres enum, so adding a
// new role is a one-line change in backend/src/constants.ts instead of a
// migration. The allowed values ("ADMIN" | "MINISTER" | "SUPPORT_STAFF")
// live there and are validated at the API boundary (zod), not by the database.

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  active       Boolean  @default(true) // deactivated users can't log in — see routes/users.ts
  createdAt    DateTime @default(now())

  assignedPeople Person[]  @relation("AssignedMinister")
  visitsLogged   Visit[]   @relation("VisitLoggedBy")
  auditEntries   AuditLog[]
  pushTokens     PushToken[]
}

// --- Parishioner record ----------------------------------------------------

model Person {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  address   String?
  phone     String?
  email     String?
  notesFlag String? // short non-sensitive flag e.g. "Homebound" — shown to all roles
  photoUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedMinisterId String?
  assignedMinister   User?   @relation("AssignedMinister", fields: [assignedMinisterId], references: [id])

  familyMembers     FamilyMember[]
  emergencyContacts EmergencyContact[]
  visits            Visit[]
}

// Lightweight family reference — deliberately thin. We store just enough to
// answer "who are this person's people" without creating a full sensitive
// record for the family member themselves (see README > Handling Sensitive Data).
model FamilyMember {
  id           String  @id @default(cuid())
  personId     String
  person       Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  name         String
  relationship String // "Spouse", "Daughter", "Son", "Sibling", etc.
  phone        String?
}

model EmergencyContact {
  id           String  @id @default(cuid())
  personId     String
  person       Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  name         String
  relationship String?
  phone        String
  email        String?

  alternateForVisits Visit[] @relation("VisitAlternateContact")
}

// --- Visits / schedule -----------------------------------------------------

// Same story as Role above: `status` and `contactMethod` are plain strings
// rather than native enums. Valid values live in backend/src/constants.ts
// (VisitStatus, ContactMethod).

model Visit {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  scheduledFor DateTime
  status        String  @default("SCHEDULED")
  contactMethod String? // set once the visit/contact actually happens
  notes         String? // SENSITIVE — access gated by role, see rbac.ts

  alternateContactId String?
  alternateContact   EmergencyContact? @relation("VisitAlternateContact", fields: [alternateContactId], references: [id])

  loggedById String?
  loggedBy   User?   @relation("VisitLoggedBy", fields: [loggedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Accountability ---------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // e.g. "VIEW_NOTES", "EDIT_NOTES", "VIEW_PERSON"
  personId  String?
  visitId   String?
  createdAt DateTime @default(now())
}

// --- Push notifications ------------------------------------------------------

// One row per device a user has logged in on (Expo issues a token per
// installation, not per account) — see routes/notifications.ts.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
}
